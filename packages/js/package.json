{
  "name": "errdown",
  "version": "0.1.0-alpha.0",
  "description": "Cloudflare-compatible structured errors (RFC 9457) for every HTTP error your agent hits.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "js-tiktoken": "^1.0.21",
    "turndown": "^7.2.5",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtZab0/errdown.git",
    "directory": "packages/js"
  },
  "homepage": "https://artzab0.github.io/errdown",
  "keywords": [
    "rfc9457",
    "problem-details",
    "errors",
    "ai-agents",
    "llm",
    "mcp",
    "cloudflare",
    "http"
  ],
  "publishConfig": {
    "tag": "alpha",
    "access": "public"
  }
}
