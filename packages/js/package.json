{
  "name": "errdown",
  "version": "0.1.0",
  "description": "Cloudflare-compatible structured errors (RFC 9457) for every HTTP error your agent hits.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "js-tiktoken": "^1.0.21",
    "turndown": "^7.2.5",
    "typescript": "^5.9.0"
  }
}
